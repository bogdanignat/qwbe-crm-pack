# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# the isolated UI fixture's own build output (e2e/ui/fixture.mjs, QWBE_DIST_DIR)
/.next-ui-fixture/
# the throwaway tsconfig that same fixture hands to `next build` (QWBE_TSCONFIG)
# so the tracked tsconfig.json is never rewritten. Deleted after every run; listed
# here in case a crash leaves it behind.
/tsconfig.ui-fixture.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is committed
!.env.example
